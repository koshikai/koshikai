# ==============================================================================
# Site Configuration
# ==============================================================================
# サイトのデフォルト表示モード (portfolio | mathkb)
# portfolio: ポートフォリオサイトとして起動
# mathkb: 数学ナレッジベースとして起動
SITE_VARIANT=portfolio

# サイトのベースURL (Metadata や Sitemap 生成に使用)
SITE_URL=http://localhost:3000

# ==============================================================================
# Database (Math Knowledge Base)
# ==============================================================================
# 数学KB用の PostgreSQL 接続文字列
# フォーマット: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
MATHKB_DATABASE_URL=postgresql://postgres:password@localhost:5432/mathkb

# SSL接続の要否 (require | disable)
# 自宅内サーバーなど自己署名証明書や非SSL環境の場合は disable を推奨
MATHKB_DATABASE_SSL=disable

# DB 接続プールの最大数 (default: 10)
MATHKB_POOL_MAX=10

# ==============================================================================
# MCP (Model Context Protocol) Server
# ==============================================================================
# MCP サーバーのバインドホスト
MCP_BIND_HOST=0.0.0.0

# MCP サーバーのポート番号
MCP_PORT=3004

# MCP エンドポイントのパス
# ポートフォリオから参照する場合のパス
MCP_PATH=/mcp

# アクセスを許可するホスト (カンマ区切り)
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
