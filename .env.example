# Proxmox PostgreSQL Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:yourpassword@192.168.x.x:5432/postgres"

# NextAuth Configuration
# Generate a secret with `openssl rand -base64 32` or similar
AUTH_SECRET="your-random-secret-key"

# Proxmox API Configuration
# Host can be IP or hostname (e.g., 192.168.1.10)
PROXMOX_HOST="192.168.x.x"
# API Token ID (Format: user@realm!tokenid)
PROXMOX_TOKEN_ID="root@pam!koshikai"
# API Token Secret
PROXMOX_TOKEN_SECRET="your-token-secret"
# Set to true if using self-signed certificates
PROXMOX_INSECURE="true"
PROXMOX_PORT="8006"
 