SITE_VARIANT=mathkb
SITE_URL=http://127.0.0.1:3103

# Shared PostgreSQL fallback used when per-service URLs are not set.
MATHKB_DATABASE_URL=postgresql://mathkb_app:change-me@postgresql.internal:5432/mathkb

# Optional per-service overrides for least-privilege deployments.
MATHKB_APP_DATABASE_URL=postgresql://mathkb_app:change-me@postgresql.internal:5432/mathkb
MCP_DATABASE_URL=postgresql://mcp_reader:change-me@postgresql.internal:5432/mathkb

# SSL mode for pg connections. "require" enables SSL with relaxed certificate validation.
MATHKB_DATABASE_SSL=disable

# MCP HTTP server configuration.
MCP_BIND_HOST=0.0.0.0
MCP_PORT=3004
MCP_PATH=/mcp
# Optional: comma-separated hostnames/IPs allowed in the Host header.
# Example: MCP_ALLOWED_HOSTS=10.0.100.130,localhost,127.0.0.1
MCP_ALLOWED_HOSTS=

# NocoDB management UI (optional but recommended).
NC_DB=pg://mathkb_nocodb:change-me@postgresql.internal:5432?u=mathkb_nocodb&p=change-me&d=mathkb
NC_AUTH_JWT_SECRET=replace-with-a-long-random-string
NC_PUBLIC_URL=http://127.0.0.1:8080
