# ==============================================================================
# .env.mathkb — MathKB MCP 内部スタック用 (docker-compose.internal.yaml)
# ==============================================================================
# 本番サーバーでは /opt/home/.env.mathkb に配置します。deploy workflow が
# $HOME/deploy/koshikai/.env.mathkb へ symlink します。
# このファイルが存在しない場合、内部スタックの deploy は skip されます。
#
#   cp .env.mathkb.example .env.mathkb
#
# 注意: .env.mathkb 自体は commit しないでください（.gitignore 済み）。

# ------------------------------------------------------------------------------
# 必須
# ------------------------------------------------------------------------------
# PostgreSQL 接続文字列。compose の command が MATHKB_DATABASE_URL へ渡します。
# 書き込みが不要なら mcp_reader、create/update を使うなら mcp_writer を指定します。
MCP_DATABASE_URL=postgresql://mcp_reader:change-me@10.0.0.10:5432/mathkb

# Host header allowlist（カンマ区切り）。
# compose は NODE_ENV=production かつ HTTP transport で起動するため、
# 未設定だと server が起動時に例外を投げます。
# コンテナは 3104 で publish されるため、実際にアクセスする host:port を列挙します。
MCP_ALLOWED_HOSTS=localhost:3104,127.0.0.1:3104

# ------------------------------------------------------------------------------
# 任意
# ------------------------------------------------------------------------------
# SSL 接続の要否 (require | disable)。自宅 LAN の非 SSL 環境では disable。
MATHKB_DATABASE_SSL=disable

# 以下は docker-compose.internal.yaml の environment で設定済みのため、
# 上書きしたい場合のみ記述します。
#   MATHKB_POOL_MAX=3
#   MATHKB_ENABLE_EMBEDDINGS=false   # true にすると model 読み込みで追加 memory が必要
#   MCP_BIND_HOST=0.0.0.0
#   MCP_PORT=3004
#   MCP_PATH=/mcp
