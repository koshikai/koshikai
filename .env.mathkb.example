SITE_VARIANT=mathkb
SITE_URL=http://127.0.0.1:3003

# PostgreSQL connection used by both the internal web app and MCP server.
MATHKB_DATABASE_URL=postgresql://mathkb_app:change-me@postgresql.internal:5432/mathkb
MATHKB_DATABASE_SSL=disable

# MCP HTTP server configuration.
MCP_BIND_HOST=0.0.0.0
MCP_PORT=3004
MCP_PATH=/mcp

# NocoDB management UI (optional but recommended).
NC_DB=pg://mathkb_nocodb:change-me@postgresql.internal:5432?u=mathkb_nocodb&p=change-me&d=mathkb
NC_AUTH_JWT_SECRET=replace-with-a-long-random-string
NC_PUBLIC_URL=http://127.0.0.1:8080
